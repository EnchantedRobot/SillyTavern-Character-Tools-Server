{
    "name": "sillytavern-character-tools-server",
    "version": "1.0.0",
    "description": "Repair character cards and compress images in SillyTavern user directories.",
    "main": "dist/plugin.js",
    "type": "commonjs",
    "scripts": {
        "build:dev": "webpack --mode development",
        "build": "webpack --mode production",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "verify:dist": "npm run build && git diff --exit-code -- dist"
    },
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/express": "^4.17.21",
        "@types/node": "^20.12.7",
        "eslint": "^9.0.0",
        "globals": "^15.0.0",
        "terser-webpack-plugin": "^5.3.10",
        "ts-loader": "^9.5.1",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.0.0",
        "vitest": "^2.0.0",
        "webpack": "^5.91.0",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "body-parser": "^1.20.3",
        "chalk": "^5.3.0",
        "pngquant-bin": "^9.0.0",
        "sharp": "^0.33.0"
    }
}
